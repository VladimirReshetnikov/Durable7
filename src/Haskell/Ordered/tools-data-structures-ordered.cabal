cabal-version: 3.0
name: tools-data-structures-ordered
version: 0.1.0.0
synopsis: Persistent insertion-ordered sets over CHAMP and finger trees
description: Neutral Haskell port of the repository-owned persistent ordered-set family.
category: Data
license: MIT-0
author: Vladimir Reshetnikov
maintainer: Vladimir Reshetnikov
build-type: Simple

library
  exposed-modules:
    Data.Structures.Ordered
    Data.Structures.Ordered.PersistentOrderedSet
  hs-source-dirs: src
  build-depends:
    base >=4.21 && <4.22,
    tools-data-structures-fingertree >=0.1 && <0.2,
    tools-data-structures-hamt >=0.1 && <0.2
  default-language: Haskell2010

test-suite ordered-test
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  build-depends:
    base >=4.21 && <4.22,
    tools-data-structures-hamt >=0.1 && <0.2,
    tools-data-structures-ordered >=0.1 && <0.2
  default-language: Haskell2010
