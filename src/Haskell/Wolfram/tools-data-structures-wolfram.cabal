cabal-version: 3.0
name: tools-data-structures-wolfram
version: 0.1.0.0
synopsis: Persistent Wolfram List and Association-shaped collections
description: Haskell port of the DataStructures repository Wolfram collection family.
license: MIT-0
author: Vladimir Reshetnikov
maintainer: Vladimir Reshetnikov
build-type: Simple

library
  exposed-modules:
    Data.Structures.Wolfram
    Data.Structures.Wolfram.Association
    Data.Structures.Wolfram.List
  hs-source-dirs: src
  build-depends:
    base >=4.21 && <4.22,
    tools-data-structures-fingertree,
    tools-data-structures-hamt
  default-language: Haskell2010

test-suite wolfram-test
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  build-depends:
    base >=4.21 && <4.22,
    tools-data-structures-wolfram,
    tools-data-structures-hamt
  default-language: Haskell2010
