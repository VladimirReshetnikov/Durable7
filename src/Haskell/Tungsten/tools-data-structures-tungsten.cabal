cabal-version: 3.0
name: tools-data-structures-tungsten
version: 0.1.0.0
synopsis: Persistent Tungsten List and Association-shaped collections
description: Haskell port of the DataStructures repository Tungsten collection family.
license: MIT-0
author: Vladimir Reshetnikov
maintainer: Vladimir Reshetnikov
build-type: Simple

library
  exposed-modules:
    Data.Structures.Tungsten
    Data.Structures.Tungsten.Association
    Data.Structures.Tungsten.List
  hs-source-dirs: src
  build-depends:
    base >=4.21 && <4.22,
    tools-data-structures-fingertree,
    tools-data-structures-hamt
  default-language: Haskell2010

test-suite tungsten-test
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  build-depends:
    base >=4.21 && <4.22,
    tools-data-structures-tungsten,
    tools-data-structures-hamt
  default-language: Haskell2010
