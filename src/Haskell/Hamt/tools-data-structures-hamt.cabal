cabal-version: 3.0
name: tools-data-structures-hamt
version: 0.1.0.0
synopsis: Persistent CHAMP, Patricia, and canonical Merkle map data structures
description: Haskell port of the DataStructures repository HAMT, Patricia, and Merkle search-tree families.
license: MIT-0
author: Vladimir Reshetnikov
maintainer: Vladimir Reshetnikov
build-type: Simple

library
  exposed-modules:
    Data.Structures.Hamt
    Data.Structures.Hamt.Hashable
    Data.Structures.Hamt.HashMap
    Data.Structures.Hamt.HashSet
    Data.Structures.Hamt.MerkleEncoding
    Data.Structures.Hamt.MerklePersistence
    Data.Structures.Hamt.MerkleSearchTree
    Data.Structures.Hamt.Patricia
  hs-source-dirs: src
  build-depends:
    array >=0.5 && <0.6,
    base >=4.21 && <4.22,
    bytestring >=0.12 && <0.13,
    containers >=0.7 && <0.8,
    text >=2.1 && <2.2
  default-language: Haskell2010

test-suite hamt-test
  type: exitcode-stdio-1.0
  main-is: Main.hs
  other-modules:
    PersistenceTests
  hs-source-dirs: test
  build-depends:
    base >=4.21 && <4.22,
    bytestring >=0.12 && <0.13,
    tools-data-structures-hamt
  default-language: Haskell2010
