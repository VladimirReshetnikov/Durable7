<Project>
  <!-- Inherit the workspace defaults (TargetFramework net10.0, Nullable, LangVersion preview, ImplicitUsings, …). -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!-- The benchmark harness is an executable, not a shipped API surface. More importantly, BenchmarkDotNet
         emits an autogenerated runner project under this directory's bin/, which therefore resolves THIS
         Directory.Build.props; the workspace default treats CS1591/CS1573 as errors, and BDN's generated code
         carries no XML docs, so documentation generation must be off for everything under this directory. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
</Project>
