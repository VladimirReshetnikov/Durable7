opam-version: "2.0"
synopsis: "Persistent data structures and fixed-width numerics"
description: """
Idiomatic OCaml ports of the repository-owned numerics, HAMT, FingerTree,
ordered, and Tungsten collection families.
"""
maintainer: "Durable7 maintainers"
authors: "Durable7 contributors"
license: "MIT-0"
homepage: "https://github.com/VladimirReshetnikov/Durable7"
bug-reports: "https://github.com/VladimirReshetnikov/Durable7/issues"
dev-repo: "git+https://github.com/VladimirReshetnikov/Durable7.git"
depends: [
  "ocaml" {>= "4.14"}
  "dune" {>= "3.20"}
  "zarith" {>= "1.14"}
  "digestif" {>= "1.3"}
  "uutf" {>= "1.0"}
  "alcotest" {with-test & >= "1.9"}
  "qcheck" {with-test & >= "0.91"}
  "odoc" {with-doc & >= "3.2"}
  "ocamlformat" {with-dev-setup & = "0.29.0"}
]
build: [
  ["dune" "build" "-p" name "-j" jobs]
  ["dune" "runtest" "-p" name "-j" jobs] {with-test}
]
